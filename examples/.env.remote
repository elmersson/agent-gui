# Remote Agent Configuration Example
# Copy this file to .env and configure for your environment

# ========================================
# Remote Mode Configuration
# ========================================

# Remote server address (host:port)
# Set this to enable remote agent execution
OPENCODE_REMOTE_ADDRESS=localhost:50051

# Authentication token for remote server
# Generate with: ./bin/remote-token
OPENCODE_REMOTE_TOKEN=your-token-here

# Enable TLS for secure communication
# Set to "true" for production environments
OPENCODE_REMOTE_TLS=false

# ========================================
# Claude API Configuration
# (Required on both client and server)
# ========================================

# Your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-api03-...

# ========================================
# Optional: Remote Server Configuration
# (Only used when running remote-agent server)
# ========================================

# Port for remote server to listen on
# Default: 50051
REMOTE_SERVER_PORT=50051

# Comma-separated list of valid auth tokens
# Generate multiple with: ./bin/remote-token --count 3
REMOTE_SERVER_TOKENS=token1,token2,token3

# Maximum concurrent executions on server
# 0 = unlimited (default)
REMOTE_SERVER_MAX_CONCURRENT=5

# Maximum execution timeout (e.g., "5m", "1h")
# 0 = no timeout (default)
REMOTE_SERVER_TIMEOUT=10m

# ========================================
# Examples
# ========================================

# Local Mode (default)
# Just set ANTHROPIC_API_KEY and leave OPENCODE_REMOTE_ADDRESS empty

# Remote Mode - Development
# OPENCODE_REMOTE_ADDRESS=localhost:50051
# OPENCODE_REMOTE_TOKEN=<generated-token>
# OPENCODE_REMOTE_TLS=false

# Remote Mode - Production
# OPENCODE_REMOTE_ADDRESS=agents.example.com:443
# OPENCODE_REMOTE_TOKEN=<generated-token>
# OPENCODE_REMOTE_TLS=true

# ========================================
# Security Notes
# ========================================

# 1. Never commit this file with real tokens
# 2. Use different tokens for each environment
# 3. Rotate tokens regularly
# 4. Enable TLS in production
# 5. Store tokens in secret managers (AWS Secrets Manager, HashiCorp Vault, etc.)
# 6. Use environment-specific .env files (.env.dev, .env.prod)
